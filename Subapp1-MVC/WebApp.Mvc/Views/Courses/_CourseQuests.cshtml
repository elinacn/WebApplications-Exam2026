@model WebApp.ViewModels.CourseViewModel

<h2 class="h4 mt-4">Quests (@Model.QuestTitles.Count)</h2>
@if (Model.QuestTitles.Count == 0)
{
    <p>No quests in this course.</p>
}
else
{
    <ul>
        @foreach (var title in Model.QuestTitles)
        {
            <li>@title</li>
        }
    </ul>
}
