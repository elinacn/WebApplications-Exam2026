@using WebApp.ViewModels
@model PlayQuestViewModel
@{
    ViewData["Title"] = Model.Title;
    var answeredCount = Model.Questions.Count(q => q.Type is "freeText" or "code"
        ? !string.IsNullOrWhiteSpace(q.TextAnswer) : q.SelectedKeys.Count > 0);
}

<link rel="stylesheet" href="~/css/quests.css" asp-append-version="true" />

<div class="quests-page quests-play-page">
    <div class="quests-main">
        <section class="quests-create-panel">
            <h2 class="quests-heading">@Model.Title</h2>
            <p class="quests-create-hint">@Model.Difficulty · @Model.XpReward XP on first completion</p>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="quests-create-hint">@Model.Description</p>
            }

            @if (Model.Submitted)
            {
                var result = Model.Result;
                var outcome = result is null || result.MaxScore <= 0 ? null
                    : result.Score <= 0 ? "none"
                    : result.Score >= result.MaxScore ? "perfect"
                    : result.Score * 2 >= result.MaxScore ? "high"
                    : "low";
                <div class="quests-play-result" role="status" data-quest-outcome="@outcome">
                    @if (result is null)
                    {
                        <p class="quests-play-score">You scored <strong>@Model.Questions.Where(q => q.IsCorrect).Sum(q => q.Points) of @Model.Questions.Sum(q => q.Points)</strong> points.</p>
                        <p class="text-danger">@Model.ResultError</p>
                    }
                    else
                    {
                        <p class="quests-play-score">You scored <strong>@result.Score of @result.MaxScore</strong> points.</p>
                        @if (result.PointsAwarded > 0)
                        {
                            <p>+@result.PointsAwarded XP! You now have @result.TotalPoints XP in total.</p>
                        }
                        else
                        {
                            <p>You already earned the XP for this quest. Your best score is @result.BestScore of @result.MaxScore. Retakes do not award extra XP.</p>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.StreakError))
                    {
                        <p class="text-warning">@Model.StreakError</p>
                    }
                </div>
            }

            @if (!Model.Submitted)
            {
                <div class="quests-play-progress">
                    <div class="quests-play-progress-labels">
                        <span data-quiz-current>Question 1 of @Model.Questions.Count</span>
                        <span data-quiz-count aria-live="polite">@answeredCount of @Model.Questions.Count answered</span>
                    </div>
                    <div class="quest-progress" data-quiz-progress role="progressbar" aria-label="Questions answered"
                         aria-valuemin="0" aria-valuemax="@Model.Questions.Count" aria-valuenow="@answeredCount">
                        <span class="quest-progress-fill" style="width: @(Model.Questions.Count == 0 ? 0 : answeredCount * 100 / Model.Questions.Count)%"></span>
                    </div>
                </div>
            }

            <form class="quests-create-form" method="post" asp-controller="Quests" asp-action="Play" asp-route-id="@Model.Id">
                @for (var i = 0; i < Model.Questions.Count; i++)
                {
                    var q = Model.Questions[i];

                    <fieldset class="quests-create-block" data-quiz-question disabled="@Model.Submitted">
                        <div class="quests-q-header">
                            <h4 class="quests-q-title">Question @(i + 1) of @Model.Questions.Count</h4>
                            @if (Model.Submitted)
                            {
                                <span class="quests-play-badge @(q.IsCorrect ? "is-correct" : "is-wrong")">
                                    @(q.IsCorrect ? "Correct" : "Incorrect")
                                </span>
                            }
                        </div>

                        <p class="quests-play-question">@q.Question</p>
                        <input type="hidden" name="answers[@i].QuestionId" value="@q.Id" />

                        @if (q.Type == "freeText")
                        {
                            <input type="text" class="quests-play-text"
                                   name="answers[@i].Text"
                                   value="@q.TextAnswer"
                                   placeholder="Your answer"
                                   autocomplete="off" />

                            @if (Model.Submitted && !q.IsCorrect)
                            {
                                <p class="quests-play-answer">Accepted answer(s): @string.Join(", ", q.AcceptedAnswers)</p>
                            }
                        }
                        else if (q.Type == "code")
                        {
                            <pre class="quests-play-code">@q.StartCode</pre>
                            <input type="text" class="quests-play-text quests-play-code-input"
                                   name="answers[@i].Text"
                                   value="@q.TextAnswer"
                                   placeholder="Code for the ____ blank"
                                   autocomplete="off" spellcheck="false" />

                            @if (Model.Submitted && !q.IsCorrect)
                            {
                                <p class="quests-play-answer">
                                    Accepted answer(s):
                                    @for (var a = 0; a < q.AcceptedAnswers.Count; a++)
                                    {
                                        @(a > 0 ? " or " : "")<code>@q.AcceptedAnswers[a]</code>
                                    }
                                </p>
                            }
                        }
                        else
                        {
                            <p class="quests-create-hint-inline">@(q.AllowMultiple ? "Select all that apply." : "Select one.")</p>
                            <div class="quests-option-list">
                                @foreach (var option in q.Options)
                                {
                                    var isSelected = q.SelectedKeys.Contains(option.Key);
                                    var isCorrectOption = Model.Submitted && q.CorrectKeys.Contains(option.Key);
                                    var isWrongPick = Model.Submitted && isSelected && !isCorrectOption;

                                    <label class="quests-play-option @(isCorrectOption ? "is-correct" : null) @(isWrongPick ? "is-wrong" : null)">
                                        <input type="@(q.AllowMultiple ? "checkbox" : "radio")"
                                               name="answers[@i].Selected"
                                               value="@option.Key"
                                               checked="@isSelected" />
                                        <span>@option.Text</span>
                                    </label>
                                }
                            </div>
                        }

                        @if (Model.Submitted && !string.IsNullOrWhiteSpace(q.Explanation))
                        {
                            <p class="quests-play-explanation">@q.Explanation</p>
                        }
                    </fieldset>
                }

                <div class="quests-create-actions">
                    @if (!Model.Submitted)
                    {
                        <button class="quests-apply" type="submit">Submit answers</button>
                        <a class="quests-reset" asp-controller="Quests" asp-action="Quests" asp-route-section="library">Cancel</a>
                    }
                    else
                    {
                        <a class="quests-apply" asp-controller="Quests" asp-action="Play" asp-route-id="@Model.Id">Try again</a>
                        <a class="quests-reset" asp-controller="Quests" asp-action="Quests" asp-route-section="explore">Back to quests</a>
                    }
                </div>
            </form>
        </section>
    </div>
</div>

@* Quiz progress and result sounds. *@
@section Scripts {
    <script>
        (() => {
            const progress = document.querySelector('[data-quiz-progress]');
            if (!progress) return;

            const form = document.querySelector('.quests-create-form');
            const questions = [...form.querySelectorAll('[data-quiz-question]')];
            const count = document.querySelector('[data-quiz-count]');
            const current = document.querySelector('[data-quiz-current]');
            const update = () => {
                const answered = questions.filter(question =>
                    [...question.querySelectorAll('input[type="text"], input[type="radio"], input[type="checkbox"]')]
                        .some(input => input.type === 'text' ? input.value.trim().length > 0 : input.checked)
                ).length;
                const label = `${answered} of ${questions.length} answered`;
                if (count.textContent !== label) count.textContent = label;
                progress.setAttribute('aria-valuenow', answered);
                progress.querySelector('.quest-progress-fill').style.width =
                    `${questions.length ? answered / questions.length * 100 : 0}%`;
            };

            form.addEventListener('input', update);
            form.addEventListener('change', update);
            form.addEventListener('focusin', event => {
                const index = questions.indexOf(event.target.closest('[data-quiz-question]'));
                if (index >= 0) current.textContent = `Question ${index + 1} of ${questions.length}`;
            });
            window.addEventListener('pageshow', update);
            update();
        })();
    </script>
    <script>
        (()=>{
            const el = document.querySelector('[data-quest-outcome]');
            if(!el) return;

            const src = {
                none: '@Url.Content("~/sounds/quest-none.wav")',
                low: '@Url.Content("~/sounds/quest-low.wav")',
                high: '@Url.Content("~/sounds/quest-high.wav")' ,
                perfect: '@Url.Content("~/sounds/quest-perfect.wav")'

            }[el.dataset.questOutcome];
            if(!src) return;

            const audio = new Audio(src);
            audio.volume = 0.5;
            audio.play().catch(() => { });
        })();
    </script>
}
